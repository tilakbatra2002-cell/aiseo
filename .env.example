# ---- Required ----
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string

# ---- Webamazee AgentOS AI Provider (optional; platform works without AI) ----
AI_ENABLED=false
AI_PROVIDER=local            # local (ollama) | openai-compatible | groq | anthropic-compatible | custom
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_MODEL=llama3.2
AI_TEMPERATURE=0.2

# ---- Worker ----
WORKER_POLL_MS=3000
CRAWL_MAX_PAGES=25
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=300

# ---- Integrations (all optional — never fake data) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORDPRESS_DEFAULT_APP_PASSWORD=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
